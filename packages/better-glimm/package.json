{
  "name": "better-glimm",
  "version": "0.1.0",
  "description": "Framework-agnostic adapters for glimm WebGL sweep transitions — TanStack Router, SvelteKit, Vue, Astro, and vanilla.",
  "keywords": [
    "astro",
    "framework-agnostic",
    "glimm",
    "page-transition",
    "sveltekit",
    "tanstack-router",
    "vue",
    "webgl"
  ],
  "license": "MIT",
  "author": {
    "name": "atyb",
    "url": "https://x.com/atybdot",
    "email": "hi@atyb.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atybdot/better-glimm.git"
  },
  "homepage": "https://github.com/atybdot/better-glimm#readme",
  "bugs": {
    "url": "https://github.com/atybdot/better-glimm/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.ts",
      "import": "./dist/tanstack.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "glimm": "^0.3.1"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.121.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.1.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": "^5.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "peerDependencies": {
    "@tanstack/react-router": ">=1",
    "astro": ">=4",
    "react": ">=18",
    "svelte": ">=4",
    "vue": ">=3",
    "vue-router": ">=4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "vue-router": {
      "optional": true
    },
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}