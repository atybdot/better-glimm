{
  "name": "better-glimm-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "better-glimm — framework-agnostic glimm sweep transitions — plus demo apps.",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:lib": "turbo run build --filter=better-glimm",
    "build:web": "turbo run build --filter=web",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "clean": "turbo run clean",
    "prepare": "lefthook install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "publish:release": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "portless": "^0.15.7",
    "turbo": "^2.11.7"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.11.2"
}
